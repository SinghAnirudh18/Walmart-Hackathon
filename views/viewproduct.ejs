<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.title %> - Product Details</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary-bg: #f5f0e8;
      --card-bg: #faf7f2;
      --card-bg-hover: #e8d5bf;
      --accent-primary: #8b4513;
      --accent-secondary: #a0522d;
      --accent-tertiary: #d2691e;
      --accent-danger: #b22222;
      --accent-success: #6b5b28;
      --text-primary: #3e2723;
      --text-secondary: #5d4037;
      --text-muted: #8d6e63;
      --border-light: #e6d7c8;
      --border-medium: #d7c4b0;
      --shadow-light: 0 1px 3px 0 rgba(139, 69, 19, 0.1), 0 1px 2px 0 rgba(139, 69, 19, 0.06);
      --shadow-medium: 0 4px 12px rgba(139, 69, 19, 0.05);
      --shadow-large: 0 10px 15px -3px rgba(139, 69, 19, 0.1), 0 4px 6px -2px rgba(139, 69, 19, 0.05);
      --wheat: #f5deb3;
      --wheat-hover: #d4b896;
      --beige: #f5f0e8;
      --brown-light: #d2b48c;
      --brown-light-hover: #b8975c;
      --brown-medium: #a0522d;
      --brown-dark: #8b4513;
      --radius-sm: 0.375rem;
      --radius-md: 0.5rem;
      --radius-lg: 0.75rem;
      --radius-xl: 1rem;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--beige);
      line-height: 1.6;
      color: var(--text-primary);
      overflow-x: hidden;
    }

    /* Container and Layout */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 1rem;
      background: var(--beige);
      transition: background 0.3s ease, transform 0.3s ease;
    }

    .container:hover {
      background: linear-gradient(135deg, var(--brown-light) 0%, var(--wheat) 100%);
      transform: scale(1.005);
    }

    /* Breadcrumb */
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
      font-size: 0.875rem;
      color: var(--text-secondary);
      letter-spacing: 0.02em;
      text-transform: uppercase;
      font-weight: 500;
    }

    .breadcrumb a {
      color: var(--accent-primary);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .breadcrumb a:hover {
      color: var(--accent-tertiary);
    }

    .breadcrumb-separator {
      color: var(--text-muted);
    }

    /* Header Section */
    .product-header {
      margin-bottom: 2rem;
      border-bottom: 1px solid var(--border-light);
      padding-bottom: 1rem;
      background-color: #9c653e ;
    }

    .title-section {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .title {
      font-size: 1.8rem;
      font-weight: 700;
      color: var(--text-primary);
      line-height: 1.2;
      letter-spacing: -0.02em;
      animation: fadeIn 0.6s ease-out;
      margin-left: 10px;
    }

    .brand {
      font-size: 1rem;
      color: var(--text-secondary);
      font-weight: 500;
      margin-bottom: 0.5rem;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      margin-left: 10px;
    }

    /* Main Product Section - 60/40 Grid */
    .product-main {
      display: grid;
      grid-template-columns: 55% 40%;
      gap: 2rem;
      margin-bottom: 3rem;
    }

    /* Images Section */
    .images-section {
      position: sticky;
      top: 2rem;
      height: fit-content;
      background: var(--card-bg);
      padding: 1.5rem;
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-medium);
      transition: all 0.3s ease;
    }

    .images-section:hover {
      background: var(--card-bg-hover);
      transform: translateY(-2px);
      box-shadow: var(--shadow-large);
    }

    .main-image {
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-medium);
      transition: all 0.3s ease;
      cursor: zoom-in;
    }

    .main-image:hover {
      transform: scale(1.02);
      box-shadow: var(--shadow-large);
    }

    .thumbnails {
      display: flex;
      gap: 0.75rem;
      margin-top: 1rem;
      overflow-x: auto;
      padding-bottom: 0.5rem;
      scroll-snap-type: x mandatory;
      scrollbar-width: thin;
      scrollbar-color: var(--accent-primary) var(--card-bg);
    }

    .thumbnails::-webkit-scrollbar {
      height: 6px;
    }

    .thumbnails::-webkit-scrollbar-thumb {
      background: var(--accent-primary);
      border-radius: var(--radius-sm);
    }

    .thumbnails::-webkit-scrollbar-track {
      background: var(--card-bg);
    }

    .thumbnail {
      width: 80px;
      height: 80px;
      object-fit: cover;
      border-radius: var(--radius-md);
      border: 2px solid var(--border-light);
      cursor: pointer;
      transition: all 0.3s ease;
      flex-shrink: 0;
      scroll-snap-align: start;
    }

    .thumbnail:hover,
    .thumbnail.active {
      border-color: var(--accent-primary);
      transform: scale(1.05);
      box-shadow: var(--shadow-light);
    }

    /* Product Details Section */
    .product-details {
      background: var(--card-bg);
      padding: 2rem;
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-medium);
      height: fit-content;
      transition: all 0.3s ease;
    }

    .product-details:hover {
      background: var(--card-bg-hover);
      transform: translateY(-2px);
      box-shadow: var(--shadow-large);
    }

    .price-section {
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .current-price {
      font-size: 2rem;
      font-weight: 700;
      color: var(--accent-primary);
    }

    .original-price {
      font-size: 1.125rem;
      color: var(--text-muted);
      text-decoration: line-through;
    }

    .discount-badge {
      display: inline-block;
      background: var(--accent-danger);
      color: white;
      padding: 0.25rem 0.75rem;
      border-radius: var(--radius-sm);
      font-size: 0.75rem;
      font-weight: 600;
    }

    .short-description {
      font-size: 1rem;
      color: var(--text-secondary);
      margin-bottom: 1.5rem;
      line-height: 1.7;
      letter-spacing: 0.01em;
    }

    /* Section Titles */
    .section-title {
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 1rem;
      position: relative;
      display: inline-block;
      letter-spacing: 0.02em;
      border-bottom: 2px solid var(--border-light);
      padding-bottom: 0.25rem;
    }

    /* Variants */
    .variants-grid {
      display: grid;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }

    .variant-item {
      background: var(--wheat);
      border: 1px solid var(--border-light);
      padding: 1rem;
      border-radius: var(--radius-md);
      transition: all 0.3s ease;
      cursor: pointer;
    }

    .variant-item:hover {
      border-color: var(--accent-primary);
      background: var(--wheat-hover);
      transform: translateY(-1px);
      box-shadow: var(--shadow-light);
    }

    .variant-item.selected {
      border-color: var(--accent-primary);
      background: var(--brown-light);
      box-shadow: 0 0 0 1px var(--accent-primary);
    }

    .variant-item.selected:hover {
      background: var(--brown-light-hover);
    }

    /* Action Buttons */
    .action-buttons {
      display: flex;
      gap: 1rem;
      margin: 2rem 0;
      flex-wrap: wrap;
    }

    .btn {
      padding: 0.75rem 1.5rem;
      border-radius: var(--radius-md);
      font-weight: 600;
      font-size: 0.875rem;
      border: none;
      cursor: pointer;
      transition: all 0.3s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      text-decoration: none;
    }

    .btn-primary {
      background: var(--accent-primary);
      color: white;
      padding: 12px 20px;
      font-size: 1rem;
      border-radius: var(--radius-lg);
      box-shadow: 0 2px 8px rgba(139, 69, 19, 0.1);
    }

    .btn-primary:hover {
      background: var(--brown-dark);
      transform: translateY(-2px);
      box-shadow: var(--shadow-medium);
    }

    .btn-secondary {
      background: var(--card-bg);
      color: var(--accent-primary);
      border: 2px solid var(--accent-primary);
      padding: 12px 20px;
      font-size: 1rem;
      border-radius: var(--radius-lg);
    }

    .btn-secondary:hover {
      background: var(--accent-primary);
      color: white;
      transform: translateY(-2px);
      box-shadow: var(--shadow-medium);
    }

    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
    }

    /* Tags */
    .tags {
      margin-top: 1.5rem;
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .tag {
      display: inline-block;
      background: var(--wheat);
      color: var(--text-secondary);
      padding: 0.25rem 0.75rem;
      border-radius: var(--radius-lg);
      font-size: 0.75rem;
      border: 1px solid var(--border-light);
      transition: all 0.3s ease;
    }

    .tag:hover {
      background: var(--accent-tertiary);
      color: white;
      transform: scale(1.05);
    }

    /* Trust Badges */
    .trust-badges {
      display: flex;
      gap: 1rem;
      margin-top: 1rem;
      flex-wrap: wrap;
    }

    .trust-badge {
      background: var(--wheat);
      color: var(--text-secondary);
      padding: 0.5rem 1rem;
      border-radius: var(--radius-md);
      font-size: 0.875rem;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* Content Sections */
    .content-section {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto 3rem auto;
      background: var(--card-bg);
      padding: 2rem;
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-medium);
      transition: all 0.3s ease;
      animation: fadeInUp 0.6s ease-out;
    }

    .content-section:hover {
      background: var(--card-bg-hover);
      transform: translateY(-2px);
      box-shadow: var(--shadow-large);
    }

    .content-section p {
      color: var(--text-secondary);
      line-height: 1.7;
      font-size: 1rem;
      max-width: 800px;
    }

    /* Reviews */
    .review {
      border-bottom: 1px solid var(--border-light);
      padding: 1.5rem 0;
      transition: all 0.3s ease;
      border-radius: var(--radius-md);
    }

    .review:hover {
      background: var(--card-bg-hover);
      margin: 0 -1rem;
      padding: 1.5rem 1rem;
      box-shadow: var(--shadow-light);
      transform: translateX(5px);
    }

    .review:last-child {
      border-bottom: none;
    }

    .review-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.5rem;
    }

    .review-name {
      font-weight: 600;
      color: var(--text-primary);
      font-size: 1rem;
    }

    .review-rating {
      color: var(--accent-tertiary);
      font-size: 0.875rem;
    }

    .review-date {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-bottom: 0.75rem;
    }

    .review-comment {
      color: var(--text-secondary);
      line-height: 1.6;
    }

    .review-count {
      background: var(--border-light);
      color: var(--text-secondary);
      padding: 0.25rem 0.5rem;
      border-radius: var(--radius-sm);
      font-size: 0.75rem;
      font-weight: 500;
      margin-left: 0.5rem;
    }

    .review-skeleton {
      background: var(--border-light);
      padding: 1rem;
      border-radius: var(--radius-md);
      color: var(--text-muted);
      font-style: italic;
    }

    /* Post Cart Info Section */
    .post-cart-info {
      background: var(--wheat);
      padding: 1.5rem;
      border-radius: var(--radius-md);
      margin-top: 1.5rem;
      transition: all 0.3s ease;
      box-shadow: var(--shadow-medium);
    }

    .post-cart-info:hover {
      background: var(--wheat-hover);
      transform: translateY(-1px);
      box-shadow: var(--shadow-large);
    }

    .rating-section, .stock-section {
      margin-bottom: 1rem;
    }

    .rating-section:last-child, .stock-section:last-child {
      margin-bottom: 0;
    }

    .rating-badge, .stock-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.875rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }

    .rating-stars {
      color: var(--accent-tertiary);
    }

    .stock-badge.in-stock {
      color: var(--accent-success);
    }

    .stock-badge.out-of-stock {
      color: var(--accent-danger);
    }

    /* Modal Styles */
    #overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.5);
      z-index: 99;
      cursor: pointer;
      backdrop-filter: blur(4px);
    }

    .modal {
      display: none;
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: var(--card-bg);
      padding: 2rem;
      border-radius: var(--radius-xl);
      z-index: 100;
      box-shadow: var(--shadow-large);
      max-width: 450px;
      width: 90%;
      animation: modalSlideIn 0.3s ease;
      transition: background-color 0.3s ease;
    }

    .modal:hover {
      background: var(--card-bg-hover);
    }

    .modal h3 {
      color: var(--text-primary);
      margin-bottom: 1rem;
      font-size: 1.5rem;
      font-weight: 600;
      letter-spacing: 0.02em;
    }

    .modal p {
      color: var(--text-secondary);
      margin-bottom: 1.5rem;
      line-height: 1.7;
    }

    .form-group {
      margin-bottom: 1rem;
    }

    .form-label {
      display: block;
      font-weight: 500;
      color: var(--text-primary);
      margin-bottom: 0.5rem;
      font-size: 0.875rem;
      letter-spacing: 0.02em;
    }

    .form-input {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid var(--border-medium);
      border-radius: var(--radius-md);
      font-size: 1rem;
      transition: all 0.3s ease;
      background: var(--card-bg);
    }

    .form-input:focus {
      outline: none;
      border-color: var(--accent-primary);
      box-shadow: 0 0 0 3px rgba(139, 69, 19, 0.1);
      background: white;
    }

    .form-input:hover {
      background: var(--card-bg-hover);
    }

    .modal-actions {
      display: flex;
      gap: 1rem;
      justify-content: flex-end;
      margin-top: 1.5rem;
    }

    /* Animations */
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes modalSlideIn {
      from { opacity: 0; transform: translate(-50%, -60%); }
      to { opacity: 1; transform: translate(-50%, -50%); }
    }

    /* Responsive Design */
    @media (max-width: 1024px) {
      .container {
        padding: 1.5rem 1rem;
      }

      .product-main {
        gap: 1.5rem;
      }

      .content-section {
        max-width: 1200px;
      }
    }

    @media (max-width: 768px) {
      .product-main {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }

      .images-section {
        position: static;
      }

      .title-section {
        flex-direction: column;
        align-items: flex-start;
      }

      .title {
        font-size: 1.6rem;
      }

      .current-price {
        font-size: 1.75rem;
      }

      .product-details {
        padding: 1.5rem;
      }

      .content-section {
        padding: 1.5rem;
        max-width: 100%;
      }

      .action-buttons {
        flex-direction: column;
      }

      .btn {
        justify-content: center;
        width: 100%;
      }
    }

    @media (max-width: 480px) {
      .container {
        padding: 1rem 0.5rem;
      }

      .title {
        font-size: 1.4rem;
      }

      .current-price {
        font-size: 1.5rem;
      }

      .product-details {
        padding: 1rem;
      }

      .content-section {
        padding: 1rem;
      }

      .thumbnails {
        justify-content: center;
      }

      .thumbnail {
        width: 60px;
        height: 60px;
      }

      .modal {
        padding: 1.5rem;
        width: 95%;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Breadcrumb -->
    <nav class="breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumb-separator">/</span>
      <a href="/category">Category</a>
      <span class="breadcrumb-separator">/</span>
      <span><%= product.title %></span>
    </nav>

    <!-- Product Header -->
    <div class="product-header">
      <div class="title-section">
        <div>
          <h1 class="title"><%= product.title %></h1>
          <p class="brand">Brand: <%= product.brand || 'N/A' %></p>
        </div>
      </div>
    </div>

    <!-- Main Product Section -->
    <div class="product-main">
      <!-- Images -->
      <div class="images-section">
        <img src="<%= product.thumbnail %>" alt="<%= product.title %>" class="main-image" id="mainImage">
        <div class="thumbnails">
          <img src="<%= product.thumbnail %>" alt="Thumbnail" class="thumbnail active" onclick="switchImage(this)">
          <% product.images.forEach(img => { %>
            <img src="<%= img.url %>" alt="<%= img.alt %>" class="thumbnail" onclick="switchImage(this)">
          <% }) %>
        </div>
      </div>

      <!-- Product Details -->
      <div class="product-details">
        <div class="price-section">
          <% if (product.discountPrice) { %>
            <span class="current-price">₹<%= product.discountPrice %></span>
            <span class="original-price">₹<%= product.price %></span>
            <span class="discount-badge"><%= Math.round(((product.price - product.discountPrice) / product.price) * 100) %>% OFF</span>
          <% } else { %>
            <span class="current-price">₹<%= product.price %></span>
          <% } %>
        </div>

        <p class="short-description"><%= product.shortDescription %></p>

        <% if (product.variants.length > 0) { %>
          <div class="section-title">Available Variants</div>
          <div class="variants-grid">
            <% product.variants.forEach((v, index) => { %>
              <div class="variant-item" onclick="selectVariant(<%= index %>)">
                <div><strong>Color:</strong> <%= v.color %> | <strong>Size:</strong> <%= v.size %></div>
                <div><strong>Price:</strong> ₹<%= v.price %> | <strong>Stock:</strong> <%= v.stockCount %></div>
              </div>
            <% }) %>
          </div>
        <% } %>

        <!-- Action Buttons -->
        <div class="action-buttons">
          <% if (product.inStock) { %>
            <button onclick="openCartOptions()" class="btn btn-primary">
              🛒 Add to Cart
            </button>
            <button onclick="openFriendCartForm()" class="btn btn-secondary">
              👥 Share with Friends
            </button>
          <% } else { %>
            <button class="btn btn-primary" disabled>
              Out of Stock
            </button>
          <% } %>
        </div>

        <!-- Trust Badges -->
        <div class="trust-badges">
          <span class="trust-badge">🚚 Free Shipping</span>
          <span class="trust-badge">✅ Verified Product</span>
        </div>

        <% if (product.tags.length > 0) { %>
          <div class="tags">
            <% product.tags.forEach(tag => { %>
              <span class="tag"><%= tag %></span>
            <% }) %>
          </div>
        <% } %>

        <!-- Reviews and Stock Status Section -->
        <div class="post-cart-info">
          <div class="rating-section">
            <div class="rating-badge">
              <span class="rating-stars">★★★★☆</span>
              <span>4.2/5 <span class="review-count">24 reviews</span></span>
            </div>
          </div>
          <div class="stock-section">
            <div class="stock-badge <%= product.inStock ? 'in-stock' : 'out-of-stock' %>">
              <span>●</span>
              <%= product.inStock ? 'In Stock' : 'Out of Stock' %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Description -->
    <div class="content-section">
      <div class="section-title">Product Description</div>
      <p><%= product.description %></p>
    </div>

    <!-- Reviews -->
    <div class="content-section">
      <div class="section-title">Customer Reviews <span class="review-count"><%= product.reviews.length %> reviews</span></div>
      <% if (product.reviews.length > 0) { %>
        <% product.reviews.forEach(review => { %>
          <div class="review">
            <div class="review-header">
              <span class="review-name"><%= review.name %></span>
              <span class="review-rating">
                <% for(let i = 0; i < review.rating; i++) { %>★<% } %>
                <% for(let i = review.rating; i < 5; i++) { %>☆<% } %>
              </span>
            </div>
            <div class="review-date"><%= new Date(review.date).toLocaleDateString() %></div>
            <p class="review-comment"><%= review.comment %></p>
          </div>
        <% }) %>
      <% } else { %>
        <div class="review-skeleton">
          No reviews yet. Be the first to review this product!
        </div>
      <% } %>
      <button class="btn btn-secondary" style="margin-top: 1rem;" onclick="alert('Review form coming soon!')">Write a Review</button>
    </div>
  </div>

  <!-- Overlay -->
  <div id="overlay" onclick="closeModals()"></div>

  <!-- Cart Options Modal -->
  <div id="cartForm" class="modal">
    <h3>Add to Cart</h3>
    <p>Choose how you'd like to add this item to your cart:</p>
    <div class="modal-actions">
      <button onclick="addToCartDirect()" class="btn btn-primary">Just Me</button>
      <button onclick="switchToFriendForm()" class="btn btn-secondary">With Friends</button>
    </div>
  </div>

  <!-- Add With Friends Form -->
  <div id="friendForm" class="modal">
    <h3>Share with Friends</h3>
    <form onsubmit="return addToCartWithFriends()">
      <div class="form-group">
        <label for="emails" class="form-label">Friends' Email Addresses</label>
        <input type="text" id="emails" class="form-input" placeholder="friend1@example.com, friend2@example.com" required>
      </div>
      <div class="modal-actions">
        <button type="button" onclick="closeModals()" class="btn btn-secondary">Cancel</button>
        <button type="submit" class="btn btn-primary">Send Invitations</button>
      </div>
    </form>
  </div>
</body>
<script>
  function switchImage(thumbnail) {
    document.querySelectorAll('.thumbnail').forEach(thumb => thumb.classList.remove('active'));
    thumbnail.classList.add('active');
    document.getElementById('mainImage').src = thumbnail.src;
  }

  function selectVariant(index) {
    document.querySelectorAll('.variant-item').forEach(variant => variant.classList.remove('selected'));
    document.querySelectorAll('.variant-item')[index].classList.add('selected');
  }

  function openCartOptions() {
    document.getElementById('cartForm').style.display = 'block';
    document.getElementById('overlay').style.display = 'block';
  }

  function openFriendCartForm() {
    document.getElementById('friendForm').style.display = 'block';
    document.getElementById('overlay').style.display = 'block';
  }

  function closeModals() {
    document.getElementById('cartForm').style.display = 'none';
    document.getElementById('friendForm').style.display = 'none';
    document.getElementById('overlay').style.display = 'none';
  }

  function switchToFriendForm() {
    document.getElementById('cartForm').style.display = 'none';
    document.getElementById('friendForm').style.display = 'block';
  }

  function addToCartDirect() {
    alert("Product added to cart successfully!");
    closeModals();
  }

  function addToCartWithFriends() {
    const emails = document.getElementById('emails').value;
    if (emails.trim()) {
      alert("Invitations sent to: " + emails);
      closeModals();
    }
    return false;
  }

  // Intersection Observer for animations
  document.addEventListener('DOMContentLoaded', () => {
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll('.content-section, .product-main, .product-header').forEach(section => {
      section.style.opacity = '0';
      section.style.transform = 'translateY(20px)';
      section.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
      observer.observe(section);
    });
  });
</script>
</html>